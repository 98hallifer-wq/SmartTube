diff --git a/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/presenter/FreeTubeAppearance.java b/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/presenter/FreeTubeAppearance.java
new file mode 100644
index 0000000..3b0e6a8
--- /dev/null
+++ b/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/presenter/FreeTubeAppearance.java
@@ -0,0 +1,19 @@
+package com.liskovsoft.smartyoutubetv2.tv.presenter;
+
+import android.content.Context;
+import android.util.TypedValue;
+import com.liskovsoft.smartyoutubetv2.tv.R;
+
+/** Styling only: navigation and video actions remain in the upstream presenters. */
+final class FreeTubeAppearance {
+    private FreeTubeAppearance() { }
+
+    static boolean isEnabled(Context context) {
+        TypedValue value = new TypedValue();
+        return context.getTheme().resolveAttribute(R.attr.freeTubeAppearance, value, true) && value.data != 0;
+    }
+
+    static int dp(Context context, int value) {
+        return Math.round(value * context.getResources().getDisplayMetrics().density);
+    }
+}
