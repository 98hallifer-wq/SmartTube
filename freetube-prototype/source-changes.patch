+++ b/smarttubetv/src/main/res/values/freetube_theme.xml
@@ -0,0 +1,48 @@
+<resources>
+    <attr name="freeTubeAppearance" format="boolean" />
+    <color name="freetube_background">#0F0F0F</color>
+    <color name="freetube_rail">#151515</color>
+    <color name="freetube_selected">#303030</color>
+    <color name="freetube_primary">#F1F1F1</color>
+    <color name="freetube_secondary">#AAAAAA</color>
+    <color name="freetube_accent">#FF5252</color>
+    <style name="App.Theme.FreeTube.Browse" parent="App.Theme.DarkGrey.Browse">
+        <item name="freeTubeAppearance">true</item>
+        <item name="android:windowBackground">@color/freetube_background</item>
+        <item name="android:colorAccent">@color/freetube_accent</item>
+        <item name="shelfBackground">@color/freetube_background</item>
+        <item name="cardDefaultBackground">@color/freetube_background</item>
+        <item name="cardSelectedBackground">@color/freetube_selected</item>
+        <item name="brandColor">@color/freetube_rail</item>
+        <item name="brandAccentColor">@color/freetube_accent</item>
+        <item name="itemsVerticalGridStyle">@style/FreeTube.Grid</item>
+        <item name="rowHorizontalGridStyle">@style/FreeTube.Row</item>
+        <item name="headersVerticalGridStyle">@style/FreeTube.Headers</item>
+    </style>
+    <style name="App.Theme.FreeTube.Player" parent="App.Theme.DarkGrey.Player">
+        <item name="freeTubeAppearance">true</item>
+        <item name="android:windowBackground">@color/freetube_background</item>
+        <item name="android:colorAccent">@color/freetube_accent</item>
+        <item name="shelfBackground">@color/freetube_background</item>
+        <item name="cardDefaultBackground">@color/freetube_background</item>
+        <item name="cardSelectedBackground">@color/freetube_selected</item>
+        <item name="playbackProgressPrimaryColor">@color/freetube_accent</item>
+        <item name="playbackControlsIconHighlightColor">@color/freetube_accent</item>
+    </style>
+    <style name="App.Theme.FreeTube.Preferences" parent="App.Theme.DarkGrey.Preferences">
+        <item name="freeTubeAppearance">true</item>
+        <item name="android:windowBackground">@color/freetube_background</item>
+        <item name="android:colorAccent">@color/freetube_accent</item>
+        <item name="android:colorPrimary">@color/freetube_rail</item>
+    </style>
+    <style name="FreeTube.Grid" parent="GridViewStyle">
+        <item name="android:horizontalSpacing">20dp</item>
+        <item name="android:verticalSpacing">24dp</item>
+    </style>
+    <style name="FreeTube.Row" parent="RowViewStyle">
+        <item name="android:horizontalSpacing">20dp</item>
+    </style>
+    <style name="FreeTube.Headers" parent="BrowseHeaderStyle">
+        <item name="android:verticalSpacing">6dp</item>
+    </style>
+</resources>
